# =============================================================================
# Alexandrie — variables d'environnement
#
# NE PAS REMPLIR CE FICHIER A LA MAIN. `make install` en fait une copie
# nommee `.env`, pose les trois URLs d'un seul bloc et tire les secrets au
# hasard. Une cle saisie a la main est une cle faible, ou recopiee d'un
# autre projet.
# / Do not fill this in by hand: `make install` copies it and draws the
# secrets at random.
# =============================================================================

# --- Le domaine, et les trois URLs qui en decoulent ---------------------------
# CES QUATRE LIGNES BOUGENT ENSEMBLE. `make install` les ecrit d'un bloc a
# partir du seul domaine, parce que les desynchroniser casse le site de deux
# facons qui ne se voient pas :
#   - COOKIE_DOMAIN (= DOMAIN, sans protocole ni port) faux -> le login
#     REUSSIT, puis l'utilisateur est deconnecte a la page suivante.
#   - CDN_URL avec un chemin -> la signature S3 echoue et les fichiers
#     televerses deviennent inaccessibles.
# Les changer plus tard demande de RECREER les conteneurs
# (`docker compose up -d`) : le frontend les fige dans son bundle au
# demarrage. / These four move together.
DOMAIN=alexandrie.example.fr
FRONTEND_URL=https://alexandrie.example.fr
API_URL=https://api.alexandrie.example.fr
CDN_URL=https://cdn.alexandrie.example.fr

# Chemin sous lequel le CDN sert les fichiers. Il vaut le nom du bucket :
# n'y toucher que si MINIO_BUCKET change. / Matches the bucket name.
CDN_ENDPOINT=/alexandrie/

# --- Traefik ------------------------------------------------------------------
# Le resolveur ACME declare dans la configuration de Traefik. `myresolver`
# est celui de ../TraefikV3.
#
# LAISSER VIDE SUR UN POSTE DE DEV, en `.localhost`. Let's Encrypt REFUSE
# d'emettre pour un nom qui ne se termine pas par un domaine public : la
# demande echoue, Traefik la rejoue sans fin, et ses journaux se
# remplissent d'une erreur sans rapport. Vide, Traefik sert son certificat
# auto-signe et le site reste joignable — le navigateur avertit une fois.
# / Leave EMPTY on a `.localhost` dev box: Let's Encrypt refuses to issue
# for a name without a public suffix, and Traefik replays the failure.
CERT_RESOLVER=myresolver

# false = cookies Secure (Traefik termine le TLS, le navigateur parle
# toujours HTTPS). true seulement pour un acces en HTTP pur, sans proxy.
ALLOW_UNSECURE=false

# Le client S3 signeur joint le CDN par son nom public. Mettre true sur un
# poste de dev en `.localhost`, ou le certificat est auto-signe.
MINIO_INSECURE_TLS=false

# Le rendu serveur du frontend appelle l'API par son nom public : c'est lui
# qui remplit le titre, la description et le contenu des pages /doc/<id>
# pour les moteurs de recherche. Node refuse un certificat auto-signe, donc
# `0` sur un poste de dev en `.localhost`. En production, laisser `1` : le
# certificat est valide et doit etre verifie.
SSR_VERIFIER_TLS=1

# --- Drapeaux applicatifs -----------------------------------------------------
CONFIG_DISABLE_LANDING=false
CONFIG_DISABLE_SIGNUP=false
CONFIG_DISABLE_NATIVE_LOGIN=false

# Identifiants (numeriques) des comptes administrateurs, separes par des
# virgules. Se remplit APRES la creation du premier compte.
ADMIN_ACCOUNTS=

# --- Version des images -------------------------------------------------------
# `latest` suit les publications de l'amont. Pour figer une version, ou
# revenir en arriere apres une mise a jour ratee, mettre ici le TAG GIT
# d'une release de github.com/Smaug6739/Alexandrie — **avec son `v`** :
#
#     ALEXANDRIE_TAG=v8.11.0
#
# C'est le nom du tag qui nomme l'image publiee. Sans le `v`, le
# telechargement echoue sur un « manifest unknown » au demarrage.
# Appliquer avec : make install
ALEXANDRIE_TAG=latest

# --- Securite -----------------------------------------------------------------
# Tire au hasard par make install. Le changer invalide TOUTES les sessions
# en cours. / Changing it invalidates every session.
JWT_SECRET=CHANGEZ_MOI_MAKE_INSTALL_LE_FAIT

# --- Base de donnees MySQL ----------------------------------------------------
MYSQL_DATABASE=alexandrie
MYSQL_USER=alexandrie
MYSQL_PASSWORD=CHANGEZ_MOI_MAKE_INSTALL_LE_FAIT
MYSQL_ROOT_PASSWORD=CHANGEZ_MOI_MAKE_INSTALL_LE_FAIT

# --- Stockage objet S3 (RustFS) -----------------------------------------------
RUSTFS_ACCESS_KEY=CHANGEZ_MOI_MAKE_INSTALL_LE_FAIT
RUSTFS_SECRET_KEY=CHANGEZ_MOI_MAKE_INSTALL_LE_FAIT
MINIO_BUCKET=alexandrie
RUSTFS_CONSOLE_ENABLE=false
RUSTFS_LOG_LEVEL=error

# --- Memoire ------------------------------------------------------------------
# MESURES DU 17 AOUT 2026, sur cette stack, charge de 150 pages et
# 150 appels API simultanes :
#
#                      defauts amont        avec ces reglages
#   mysql              423 -> 437 Mo        129 -> 141 Mo
#   frontend (Nuxt)     86 -> 345 Mo         25 ->  80 Mo
#   rustfs             176 -> 177 Mo         70 ->  79 Mo
#   backend (Go)         9 ->  15 Mo          8 ->  11 Mo
#   ------------------------------------------------------
#   TOTAL              694 -> 974 Mo        232 -> 311 Mo
#
# Deux reglages font tout le gain, et aucun ne degrade le service :
#
# PERFORMANCE_SCHEMA=OFF divise par deux MySQL. Mesure interne : cette
# instrumentation occupait 230 Mo, soit plus qu'InnoDB lui-meme. C'est un
# outil de DIAGNOSTIC ; le remettre a ON le temps d'enqueter sur une
# lenteur, puis le recouper.
#
# TAS_NODE_MO dit a V8 ou est le plafond. Sans lui, Node dimensionne son
# tas d'apres la memoire visible de la MACHINE (30 Gio sur le poste de
# mesure) : il laisse donc enfler jusqu'a 345 Mo avant de ramasser. Avec,
# il ramasse tot et plafonne a 80 Mo — pour le meme travail, et sans
# ralentissement mesurable.
#
# Les LIMITE_MEMOIRE_* sont des plafonds de conteneur : elles ne reservent
# rien, elles empechent une derive de manger la machine. En cas de
# depassement, le noyau tue LE CONTENEUR fautif (qui redemarre) plutot que
# de choisir lui-meme sa victime — possiblement MySQL, en pleine ecriture.
# TAS_NODE_MO doit rester SOUS LIMITE_MEMOIRE_FRONTEND : le tas V8 n'est
# pas toute la memoire d'un process Node.
#
# Sur un serveur a 2 Gio, ces valeurs conviennent telles quelles ; il reste
# de quoi loger Traefik et CrowdSec (~280 Mo a eux deux).
PERFORMANCE_SCHEMA=OFF
INNODB_BUFFER_POOL=128M
TAS_NODE_MO=384
LIMITE_MEMOIRE_MYSQL=512m
LIMITE_MEMOIRE_RUSTFS=512m
LIMITE_MEMOIRE_BACKEND=256m
LIMITE_MEMOIRE_FRONTEND=512m

# --- Courriel (facultatif) ----------------------------------------------------
# Sert UNIQUEMENT a la reinitialisation de mot de passe. Laisser vide pour
# s'en passer. / Password reset only.
SMTP_HOST=
SMTP_MAIL=
SMTP_MAIL_FROM=
SMTP_PASSWORD=

# --- Serveur de sauvegarde ----------------------------------------------------
# L'adresse du borgwarehouse vers lequel cette machine sauvegardera.
# `make install` la demande ; `make backup` la reprend comme valeur par
# defaut, et la redemande si elle est vide.
#
# Elle vit ICI plutot que dans le code parce qu'elle designe VOTRE
# infrastructure : la coder en dur dans un script versionne, c'est publier
# l'adresse de ses sauvegardes sur la forge au premier `git push`.
# / It lives here rather than in the code because it names YOUR
# infrastructure: hard-coding it publishes your backup server's address.
BORGWAREHOUSE_URL=https://borgwarehouse.exemple.fr
BORGWAREHOUSE_SSH_PORT=2226

# --- Sauvegarde borg (ecrit par `make backup`, NE RIEN REMPLIR ICI) -----------
# `make backup` genere la cle SSH, cree le depot sur borgwarehouse, tire une
# passphrase et te la fait mettre au coffre. Laisser ces lignes commentees :
# les remplir a la main, c'est risquer de rendre des archives existantes
# definitivement illisibles.
#
# BORG_PREFIX=       prefixe des archives, et nom de la cle SSH du depot
# BORG_REPO=         adresse ssh:// du depot (ou un chemin absolu, en local)
# BORG_PASSPHRASE=   passphrase du depot — A METTRE AU COFFRE, avec la cle
#                    exportee (borg key export) et l'adresse du depot. Sans
#                    elles, les archives sont un bloc chiffre definitivement
#                    illisible : c'est le seul maillon que la sauvegarde ne
#                    peut pas se sauvegarder elle-meme.
# AGE_MAX_HEURES=    age max de la derniere archive avant que
#                    `make verif-archive` crie (25 pour du quotidien)
#
# Le jeton de creation de depot, lui, ne vit PAS ici : il est lu dans la
# variable d'environnement `borgwarehouse_ccc_api` (a defaut `BW_API_TOKEN`),
# le temps d'un unique appel, et n'est jamais stocke.
